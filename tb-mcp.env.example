# ThingsBoard MCP sidecar — environment template.
# Copy to tb-mcp.env on the box (chmod 600) and fill in. NEVER commit the real file.
# See docs/MCP_SIDECARS.md.

# --- SSE transport (so Mosaic can connect over http://tb-mcp:8000/sse) ---
SPRING_AI_MCP_SERVER_STDIO=false
SPRING_WEB_APPLICATION_TYPE=servlet
HTTP_BIND_ADDRESS=0.0.0.0

# --- Your ThingsBoard instance ---
THINGSBOARD_URL=https://platform.uniqgrid.com

# --- Auth: pick ONE method (use a Tenant Administrator account) ---
# Username/password (works on any version):
THINGSBOARD_USERNAME=tenant-admin@example.com
THINGSBOARD_PASSWORD=change-me
# Or, ThingsBoard 4.3+ API key (comment out the two lines above if you use this):
# THINGSBOARD_API_KEY=your_api_key
