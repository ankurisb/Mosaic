# CISO Assistant reverse proxy — plain HTTP for on-prem internal use.
# For production with a real domain, replace ":8443" with your FQDN
# and Caddy will auto-provision a TLS certificate.

:8443 {
    handle /api/* {
        reverse_proxy ciso-backend:8000 {
            header_up -X-Forwarded-Proto
        }
    }
    handle /static/* {
        reverse_proxy ciso-backend:8000 {
            header_up -X-Forwarded-Proto
        }
    }
    handle /media/* {
        reverse_proxy ciso-backend:8000 {
            header_up -X-Forwarded-Proto
        }
    }
    handle {
        reverse_proxy ciso-frontend:3000 {
            header_up -X-Forwarded-Proto
        }
    }
}
