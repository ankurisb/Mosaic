# CISO Assistant reverse proxy
# Routes :8443 → SvelteKit frontend + Django backend
# No TLS (internal on-prem use). For production with a real domain,
# replace ":8443" with your FQDN and Caddy auto-provisions TLS.

:8443 {
    # Django REST API
    handle /api/* {
        reverse_proxy ciso-backend:8000
    }

    # Django static + media files
    handle /static/* {
        reverse_proxy ciso-backend:8000
    }
    handle /media/* {
        reverse_proxy ciso-backend:8000
    }

    # SvelteKit frontend (everything else)
    handle {
        reverse_proxy ciso-frontend:3000
    }
}
