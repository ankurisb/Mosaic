# Mosaic front door (reverse proxy).
#
# PER-ORIGIN design. Each embedded tool is served at the ROOT of its own port,
# where it is designed to run — NOT under a subpath.
#
# Why: n8n and Superset both request assets and API calls at origin-root paths
# (/static/*, /rest/*, /api/v1/*) which collide with Mosaic's own routes when
# mounted at a subpath. Superset in particular cannot be mounted at a prefix at
# all (Flask's APPLICATION_ROOT only scopes cookies/URL generation; it does not
# mount the WSGI app), and its /api/v1/* overlaps Mosaic's /api/*. Subpath
# hosting required a bespoke Caddy rule per asset path and still broke. Serving
# each tool at its own origin root eliminates the entire class of problem.
#
# What is preserved (the actual goals):
#   - NO tool login page: Mosaic's handshake endpoints log in server-side and
#     set the tool's session cookie, then redirect to the tool's origin.
#   - RBAC enforced: every request is gated by forward_auth against Mosaic's
#     /api/authz/surface, and the handshake itself checks canAccessSurface().
#   - ONE login: users only ever authenticate to Mosaic.
#
# What changes: the tools are on sibling origins (different ports) rather than
# one origin. Cookies are host-scoped per tool, which is exactly how each tool
# expects to run.
#
# Ports:  443 Mosaic   8444 n8n   8445 Superset
# (CISO keeps its own existing :8443 stack and its own login for now.)

{
	# Internal CA for on-prem use without a public domain. With a real domain,
	# remove this and use FQDN site addresses for automatic public TLS.
	local_certs
}

# ── Mosaic (the app + handshake endpoints) ──────────────────────
https://{$MOSAIC_HOSTNAME:localhost} {
	reverse_proxy mosaic:3001
}

# ── n8n (served at its own origin root) ─────────────────────────
https://{$MOSAIC_HOSTNAME:localhost}:8444 {
	# Auto re-login: bounce n8n's logout back through the Mosaic handshake
	# instead of showing n8n's login page.
	@logout path /rest/logout /signout
	redir @logout https://{$MOSAIC_HOSTNAME:localhost}/api/authz/n8n-login 302

	# No n8n session yet (e.g. a bookmark or expired cookie) → run the
	# handshake first. NAVIGATIONS ONLY: asset/XHR requests must never be
	# redirected, or they receive HTML and fail strict MIME checks.
	@needs_login {
		not header Cookie *n8n-auth=*
		header Sec-Fetch-Mode navigate
	}
	redir @needs_login https://{$MOSAIC_HOSTNAME:localhost}/api/authz/n8n-login 302

	# RBAC gate on every request (defence in depth alongside the handshake).
	forward_auth mosaic:3001 {
		uri /api/authz/surface?name=n8n
		copy_headers X-Mosaic-User X-Mosaic-Role
	}

	# Websockets (editor canvas) upgrade automatically through reverse_proxy.
	reverse_proxy n8n:5678
}

# ── Superset (served at its own origin root) ────────────────────
https://{$MOSAIC_HOSTNAME:localhost}:8445 {
	@logout path /logout /logout/
	redir @logout https://{$MOSAIC_HOSTNAME:localhost}/api/authz/superset-login 302

	@needs_login {
		not header Cookie *session=*
		header Sec-Fetch-Mode navigate
	}
	redir @needs_login https://{$MOSAIC_HOSTNAME:localhost}/api/authz/superset-login 302

	forward_auth mosaic:3001 {
		uri /api/authz/surface?name=superset
		copy_headers X-Mosaic-User X-Mosaic-Role
	}

	reverse_proxy superset:8088
}
