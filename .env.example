# ── Mosaic — Environment Configuration ───────────────────────
# Copy to .env.local and fill in your values.
# For Docker deployments, these are also read by docker-compose.yml

# ── Required ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
AUTH_SECRET=replace-with-openssl-rand-hex-32

# First-run admin account (also used for Superset admin)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Your Name

# ── Database ─────────────────────────────────────────────────
# Leave blank for SQLite (local/Docker). Set for Neon Postgres (cloud).
# DATABASE_URL — leave blank for Docker/local SQLite (auto-configured by docker-compose.yml)
# For Neon Postgres (Vercel cloud): DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── AI Features ──────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Notifications ─────────────────────────────────────────────
CRON_SECRET=replace-with-openssl-rand-hex-32
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# ── Superset ─────────────────────────────────────────────────
# Admin credentials are synced from ADMIN_EMAIL/ADMIN_PASSWORD above.
# SUPERSET_ADMIN_PASSWORD defaults to ADMIN_PASSWORD if not set.
SUPERSET_SECRET_KEY=replace-with-openssl-rand-hex-32
SUPERSET_ADMIN_PASSWORD=same-as-admin-password
SUPERSET_DB_PASSWORD=superset-db-internal-password

# In Docker: Mosaic talks to Superset via internal network
# In local dev: point to localhost
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin

# ── Airbyte ──────────────────────────────────────────────────
# Docker Compose mode uses basic auth (not OAuth2)
# These credentials are for the Airbyte API — users never see them
AIRBYTE_USER=airbyte
AIRBYTE_PASSWORD=password
