# ── Mosaic — Environment Configuration ───────────────────────
# Copy to .env.local and fill in your values.
# For Docker deployments these are also read by docker-compose.yml.
#
# The installer (bash install.sh) generates all cryptographic secrets
# automatically. See SECRETS.md for what each secret does, how to
# rotate it, and what breaks if it leaks.

# ── Required ─────────────────────────────────────────────────

# Signs every user session token. Change → everyone is logged out (safe to rotate).
# Leak → an attacker can impersonate any user. Rotate immediately.
# Generate: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32

# First-run admin account (also used for Superset admin).
# Changing these after first run has no effect — use Settings → Users instead.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Your Name

# Public URL of this Mosaic instance. Used to build links that point back at
# Mosaic: SSO/OAuth callback URLs and invite/welcome emails.
# Defaults to http://localhost:3001 — fine locally, WRONG in production, where
# invite emails would contain localhost links and SSO callbacks would fail.
# Env-only: NEXT_PUBLIC_ vars are inlined at build time, so this cannot be set
# from Settings → API Keys.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── AI ───────────────────────────────────────────────────────

# Anthropic Claude API key. Can also be set in Settings → API Keys after first run.
# Leak → revoke at console.anthropic.com immediately.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Database ─────────────────────────────────────────────────
# Leave blank for SQLite (local/Docker). Set for Neon Postgres (cloud).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Notifications / Scheduler ────────────────────────────────

# Authenticates internal scheduled jobs (retention purges, audit checks).
# Change → jobs stop until restart. Leak → someone can trigger jobs manually.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# ── Optional: Web search ─────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Superset ─────────────────────────────────────────────────
# Admin credentials are synced from ADMIN_EMAIL/ADMIN_PASSWORD above.

# ⚠ SET ONCE — NEVER CHANGE AFTER FIRST BOOT.
# Changing this after first run makes all Superset data source connections
# unreadable. You will have to reconfigure them from scratch.
# Generate: openssl rand -hex 32
SUPERSET_SECRET_KEY=replace-with-openssl-rand-hex-32

SUPERSET_ADMIN_PASSWORD=same-as-admin-password
SUPERSET_DB_PASSWORD=superset-db-internal-password  # Docker-internal only, never exposed externally

# In Docker: Mosaic talks to Superset via internal network
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin

# ── SSO / Keycloak (optional) ────────────────────────────────
# Uncomment both lines to include Keycloak in docker compose up -d.
# After enabling: see KEYCLOAK.md for realm + client setup (5 min).
# SSO_ENABLED=true
# COMPOSE_PROFILES=sso
# KEYCLOAK_URL=http://keycloak:8080
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=change-me-before-production

# ── Airbyte ──────────────────────────────────────────────────
# Docker Compose mode uses basic auth. Users never see these credentials.
AIRBYTE_USER=airbyte
AIRBYTE_PASSWORD=password

# ── CISO Assistant (GRC Platform) ────────────────────────────
# Superuser created automatically on first docker compose up.
# Log in at http://localhost:8443 after the stack starts.
# Changing these after first run has no effect — see DOCKER.md to reset.
CISO_SUPERUSER_EMAIL=admin@yourcompany.com
CISO_SUPERUSER_PASSWORD=choose-a-strong-password
